# -----------------------------------------------------------------------------
# Stagehand — root .gitignore
# -----------------------------------------------------------------------------

# Visual Studio / Rider / .NET build output
bin/
obj/
publish/
packages/
artifacts/
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# ReSharper / Rider caches
_ReSharper*/
*.DotSettings.user

# Build/output artefacts
*.tlog
*.binlog
*.log
logs/
TestResults/
[Tt]est[Rr]esult*/
coverage*.xml
coverage*.json
*.coverage
*.coveragexml

# Local NuGet caches (we use central package management)
.nuget/
*.nupkg
*.snupkg

# Secrets / signing material — never commit
*.pfx
*.snk
secrets.*
.env
.env.*
!.env.example

# Node / prettier tooling
node_modules/

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editor scratch
*.swp
*.swo
*~

# Generated brand assets that ship as binary outputs of the icon pipeline.
# The source SVGs in app/assets/brand/ ARE committed; these derived files are not.
app/src/App.Shell/Assets/TrayIcon*.ico
app/src/App.Shell/Assets/WelcomeHero.png

# Claude
.claude/settings.*
