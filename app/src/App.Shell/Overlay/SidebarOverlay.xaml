<Window
    x:Class="App.Shell.Overlay.SidebarOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AllowsTransparency="True"
    Background="#01000000"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None">
    <!--
        DWM paints thumbnails directly into the window surface — no visual
        tree needed. A 1px edge accent is drawn for debuggability and is
        removed in Plan 04 polish (§Design.8).
    -->
    <Grid IsHitTestVisible="False">
        <Border
            x:Name="EdgeAccent"
            BorderBrush="#88FFFFFF"
            BorderThickness="1,0,0,0" />
        <Canvas x:Name="HoverLayer">
            <Border
                x:Name="HoverHighlight"
                BorderBrush="#CCFFFFFF"
                BorderThickness="2"
                CornerRadius="4"
                Visibility="Collapsed" />
        </Canvas>
    </Grid>
</Window>
