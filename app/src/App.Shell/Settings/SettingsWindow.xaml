<Window
    x:Class="App.Shell.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="800"
    Height="600"
    MinWidth="640"
    MinHeight="480"
    WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="16"
            Text="Settings will be implemented in Plan 04."
            TextWrapping="Wrap" />
        <Button
            Grid.Row="1"
            Padding="16,6"
            HorizontalAlignment="Right"
            Click="OnCloseClick"
            Content="Close"
            IsCancel="True" />
    </Grid>
</Window>
