<Window
    x:Class="App.Harness.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plan 02 — Stagehand Harness"
    Width="900"
    Height="600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="420" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="8"
            FontSize="14"
            FontWeight="Bold"
            Text="Manual test runner for Plan 02 (window enumeration, controller, DWM thumbnails, WinEvent hook)." />

        <!--  Left: ListBox of manageable windows.  -->
        <DockPanel
            Grid.Row="1"
            Grid.Column="0"
            Margin="8">
            <TextBlock
                Margin="0,0,0,4"
                DockPanel.Dock="Top"
                FontWeight="SemiBold"
                Text="Manageable windows" />
            <ListBox
                x:Name="WindowList"
                HorizontalContentAlignment="Stretch"
                SelectionChanged="OnWindowSelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                            <TextBlock FontSize="10" Foreground="#666">
                                <Run Text="class=" />
                                <Run Text="{Binding ClassName}" />
                                <Run Text="  hwnd=0x" />
                                <Run Text="{Binding Hwnd, StringFormat=X}" />
                            </TextBlock>
                            <TextBlock FontSize="10" Foreground="#666">
                                <Run Text="bounds=" />
                                <Run Text="{Binding Bounds.X}" />
                                <Run Text="," />
                                <Run Text="{Binding Bounds.Y}" />
                                <Run Text=" " />
                                <Run Text="{Binding Bounds.Width}" />
                                <Run Text="x" />
                                <Run Text="{Binding Bounds.Height}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  Right: Buttons + hook log + GDI counter.  -->
        <DockPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Vertical">
                <Button
                    x:Name="RefreshButton"
                    Margin="0,2"
                    Padding="8,4"
                    Click="OnRefreshClicked"
                    Content="Refresh" />
                <Button
                    x:Name="ShowSidebarButton"
                    Margin="0,2"
                    Padding="8,4"
                    Click="OnShowSidebarClicked"
                    Content="Show Sidebar" />
                <Button
                    x:Name="ParkButton"
                    Margin="0,2"
                    Padding="8,4"
                    Click="OnParkClicked"
                    Content="Park (selected)"
                    IsEnabled="False" />
                <Button
                    x:Name="RestoreButton"
                    Margin="0,2"
                    Padding="8,4"
                    Click="OnRestoreClicked"
                    Content="Restore (selected)"
                    IsEnabled="False" />
                <Button
                    x:Name="RegisterHookButton"
                    Margin="0,2"
                    Padding="8,4"
                    Click="OnRegisterHookClicked"
                    Content="Register hook" />
            </StackPanel>

            <StackPanel
                Margin="0,8,0,0"
                DockPanel.Dock="Bottom"
                Orientation="Vertical">
                <TextBlock FontWeight="SemiBold" Text="Process resources" />
                <TextBlock
                    x:Name="GdiObjectsText"
                    FontFamily="Consolas"
                    Text="GDI objects: …" />
                <TextBlock
                    x:Name="UserObjectsText"
                    FontFamily="Consolas"
                    Text="User objects: …" />
            </StackPanel>

            <DockPanel>
                <TextBlock
                    Margin="0,8,0,4"
                    DockPanel.Dock="Top"
                    FontWeight="SemiBold"
                    Text="WinEvent hook log" />
                <TextBox
                    x:Name="HookLog"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    FontSize="10"
                    HorizontalScrollBarVisibility="Auto"
                    IsReadOnly="True"
                    TextWrapping="NoWrap"
                    VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
