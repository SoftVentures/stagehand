<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>App.Tests</RootNamespace>
    <!--
      Test methods routinely construct short-lived IDisposables inside an
      arrange-block; requiring `using` on every local obscures the scenario
      and adds no real value (xUnit constructs a fresh instance per test).
    -->
    <NoWarn>$(NoWarn);CA2000</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\app\src\App.Core\App.Core.csproj" />
    <ProjectReference Include="..\..\app\src\App.Services\App.Services.csproj" />
    <ProjectReference Include="..\..\app\src\App.Interop\App.Interop.csproj" />
    <ProjectReference Include="..\..\app\src\App.Shell\App.Shell.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
</Project>
